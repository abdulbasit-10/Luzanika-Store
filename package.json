{
  "name": "luzanika-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "node --env-file-if-exists=.env.local db/migrate.mjs up",
    "db:rollback": "node --env-file-if-exists=.env.local db/migrate.mjs down",
    "db:status": "node --env-file-if-exists=.env.local db/migrate.mjs status",
    "db:create": "node --env-file-if-exists=.env.local db/migrate.mjs create",
    "db:seed-catalog": "tsx --env-file-if-exists=.env.local db/seed-catalog.ts",
    "orders:expire": "tsx --env-file-if-exists=.env.local db/expire-orders.ts",
    "admin:create": "tsx --env-file-if-exists=.env.local db/create-super-admin.ts",
    "db:migrate:test": "node --env-file-if-exists=.env.local db/migrate.mjs up --test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.integration.config.mts",
    "test:db": "node --env-file-if-exists=.env.local --test db/migrate.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.2",
    "@tanstack/react-query": "^5.105.0",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "lucide-react": "^1.64.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.1",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "sequelize": "^6.37.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
