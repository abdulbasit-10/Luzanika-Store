# Base URL of the API. The backend is part of this Next.js app, so it is a same-site path.
NEXT_PUBLIC_API_URL=/api/v1

# Public URL of this storefront (used for metadataBase / canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- HTTP / security -------------------------------------------------------
# The site's public origin(s), comma separated. Browser requests that change data
# are only accepted from these. REQUIRED in production, e.g. https://luzanika.com
APP_ORIGINS=http://localhost:3000

# Set to true ONLY when the app runs behind nginx (or another reverse proxy you
# control) that sets X-Real-IP. Used to tell visitors apart for rate limiting.
# Never enable when the app is reachable directly: visitors could fake their IP.
TRUST_PROXY=false

# Log detail: debug | info | warn | error | silent (default: info)
LOG_LEVEL=info

# Password hashing strength (bcrypt cost). Each +1 doubles the time. Keep 12 or more in production.
BCRYPT_COST=12

# --- Uploads ---------------------------------------------------------------
# Folder where uploaded files (profile photos, later product images) are kept.
# Development: leave unset (uses ./.uploads, which git ignores).
# Production: REQUIRED. An absolute path OUTSIDE the project folder, so a deploy never wipes it,
# e.g. /var/lib/luzanika/uploads. Include it in your server backups, like the database.
# UPLOADS_DIR=/var/lib/luzanika/uploads

# --- Database (PostgreSQL) -------------------------------------------------
# Copy this file to .env.local and fill in real values. Never commit passwords.
# The setup scripts in db/setup/ create these roles and databases.

# What the running website uses: can read and write rows only.
# The shop pages (home, categories, products) are built from the catalogue in
# this database, so `next build` needs it too. After the first `npm run db:migrate`
# run `npm run db:seed-catalog` once to load the sample catalogue; it only adds
# what is missing and never touches stock or edits.
DATABASE_URL=postgres://luzanika_app:YOUR_APP_PASSWORD@localhost:5432/luzanika

# Used only to run migrations (it may change the schema). Not needed in production runtime.
DATABASE_MIGRATION_URL=postgres://luzanika_migrator:YOUR_MIGRATOR_PASSWORD@localhost:5432/luzanika

# Used only by the automated tests (a separate, throw-away database).
TEST_DATABASE_MIGRATION_URL=postgres://luzanika_migrator:YOUR_MIGRATOR_PASSWORD@localhost:5432/luzanika_test
TEST_DATABASE_URL=postgres://luzanika_app:YOUR_APP_PASSWORD@localhost:5432/luzanika_test

# --- Payments ---------------------------------------------------------------
# Who collects the money. "simulated" lets you place and "pay" orders in
# development without a payment account (a button on the order page plays the
# provider's message). The server REFUSES to start with "simulated" in
# production. Production must use "stripe" (added with the Stripe account's keys).
# PAYMENT_PROVIDER=simulated

# Unpaid orders hold their stock for 30 minutes. They are released whenever
# someone checks out or opens their orders, and on a timer on the server:
#   npm run orders:expire     (run it every 5 minutes with cron or a systemd timer)
