# Base URL of the API. The backend is part of this Next.js app, so it is a same-site path.
NEXT_PUBLIC_API_URL=/api/v1

# Public URL of this storefront (used for metadataBase / canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- HTTP / security -------------------------------------------------------
# The site's public origin(s), comma separated. Browser requests that change data
# are only accepted from these. REQUIRED in production, e.g. https://luzanika.com
APP_ORIGINS=http://localhost:3000

# Set to true ONLY when the app runs behind nginx (or another reverse proxy you
# control) that sets X-Real-IP. Used to tell visitors apart for rate limiting.
# Never enable when the app is reachable directly: visitors could fake their IP.
TRUST_PROXY=false

# Log detail: debug | info | warn | error | silent (default: info)
LOG_LEVEL=info

# Password hashing strength (bcrypt cost). Each +1 doubles the time. Keep 12 or more in production.
BCRYPT_COST=12

# --- Uploads ---------------------------------------------------------------
# All pictures (product photos, profile photos, payment screenshots) go to Cloudinary.
# Product photos are public; the others are stored as "authenticated" files that can only be
# opened through the app (staff for payment screenshots, the customer for their own photo).
# Find the three values on the Cloudinary dashboard (Settings > API keys).
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Folder inside the account; use a different one for test and live so they never mix.
# CLOUDINARY_FOLDER=luzanika
#
# Without Cloudinary, files are kept in a folder on the server's disk instead.
# Development: leave unset (uses a folder in your home directory, outside the project).
# Production without Cloudinary: REQUIRED. An absolute path OUTSIDE the project folder, so a deploy
# never wipes it, e.g. /var/lib/luzanika/uploads. Include it in your server backups.
# UPLOADS_DIR=/var/lib/luzanika/uploads

# --- Database (PostgreSQL) -------------------------------------------------
# Copy this file to .env.local and fill in real values. Never commit passwords.
# The setup scripts in db/setup/ create these roles and databases.

# What the running website uses: can read and write rows only.
# The shop pages (home, categories, products) are built from the catalogue in
# this database, so `next build` needs it too. After the first `npm run db:migrate`
# run `npm run db:seed-catalog` once to load the sample catalogue; it only adds
# what is missing and never touches stock or edits.
DATABASE_URL=postgres://luzanika_app:YOUR_APP_PASSWORD@localhost:5432/luzanika

# Used only to run migrations (it may change the schema). Not needed in production runtime.
DATABASE_MIGRATION_URL=postgres://luzanika_migrator:YOUR_MIGRATOR_PASSWORD@localhost:5432/luzanika

# Used only by the automated tests (a separate, throw-away database).
TEST_DATABASE_MIGRATION_URL=postgres://luzanika_migrator:YOUR_MIGRATOR_PASSWORD@localhost:5432/luzanika_test
TEST_DATABASE_URL=postgres://luzanika_app:YOUR_APP_PASSWORD@localhost:5432/luzanika_test

# --- Payments ---------------------------------------------------------------
# Who collects the money. "simulated" lets you place and "pay" orders in
# development without a payment account (a button on the order page plays the
# provider's message). The server REFUSES to start with "simulated" in
# production. Production must use "stripe" (added with the Stripe account's keys).
# PAYMENT_PROVIDER=simulated

# Unpaid orders hold their stock for 30 minutes. They are released whenever
# someone checks out or opens their orders, and on a timer on the server:
#   npm run orders:expire     (run it every 5 minutes with cron or a systemd timer)

# --- Shipping, tax and shop details ----------------------------------------
# Shipping fees, the German VAT rate, the unpaid-order hold time and the shop's
# contact details are settings in the database. Staff change them in the admin
# (GET/PATCH /api/v1/admin/settings), so there is nothing to set here.

# --- Email ------------------------------------------------------------------
# Password-reset emails and contact-form messages are sent through this mail server.
# Without SMTP_HOST, development prints emails in the server log; production refuses
# to send (password reset then answers "try again shortly"; the contact form still saves the message,
# but replies from the admin cannot be sent).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# "true" when the connection is encrypted from the start (usually port 465), "false" for STARTTLS (587).
# Leave unset to use true on port 465 and false otherwise.
# SMTP_SECURE=false
# Both or neither (a server that needs no login).
# SMTP_USER=
# SMTP_PASSWORD=
# Who emails come from. Required once SMTP_HOST is set, e.g. Luzanika <shop@luzanika.com>
# MAIL_FROM=
# Contact-form messages are always saved for the admin's Contact Us inbox. Set this to
# also get an email for each new message (optional; a failed email never fails the form).
# CONTACT_TO_EMAIL=

# --- Admin (staff) ----------------------------------------------------------
# Encrypts the authenticator-app secrets of staff. REQUIRED to use the admin.
# 32 random bytes as base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it out of git and out of the database. If it is lost, staff set up 2FA again.
# STAFF_2FA_ENCRYPTION_KEY=
#
# Create the first super admin once (prints a one-time link to choose a password):
#   npm run admin:create -- --email owner@example.com --first Ada --last Lovelace
